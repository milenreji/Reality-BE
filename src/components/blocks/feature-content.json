{
  "collectionName": "components_blocks_feature_contents",
  "info": {
    "displayName": "Feature Content"
  },
  "options": {},
  "attributes": {
    "preTitle": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "infoTitle": {
      "type": "string"
    },
    "infoSummary": {
      "type": "component",
      "component": "elements.meta",
      "repeatable": false
    },
    "description": {
      "type": "blocks"
    },
    "metaData": {
      "type": "component",
      "component": "elements.meta",
      "repeatable": true
    },
    "showContactItems": {
      "type": "boolean",
      "default": false
    },
    "contactItems": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "showContactItems"
            },
            true
          ]
        }
      },
      "component": "elements.contact-item",
      "repeatable": true
    },
    "media": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "cta": {
      "type": "component",
      "component": "elements.link",
      "repeatable": true
    },
    "appearance": {
      "type": "component",
      "component": "elements.appearance",
      "repeatable": false
    }
  },
  "config": {}
}
