{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "preTitle": {
      "type": "string"
    },
    "badge": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "metaData": {
      "type": "component",
      "component": "elements.meta",
      "repeatable": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "eventStatus": {
      "type": "enumeration",
      "enum": [
        "active",
        "draft",
        "expired"
      ]
    },
    "description": {
      "type": "blocks"
    },
    "cta": {
      "type": "component",
      "component": "elements.link",
      "repeatable": true
    },
    "eventSchedule": {
      "type": "component",
      "component": "blocks.schedule-details",
      "repeatable": false
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "eventNotice": {
      "type": "component",
      "component": "elements.text-module",
      "repeatable": false
    }
  }
}
